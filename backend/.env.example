NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/universidad
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# Talanquera Arduino. `auto` usa serial si hay puerto configurado y simulacion si no responde.
TURNSTILE_ENABLED=true
TURNSTILE_MODE=auto
TURNSTILE_SERIAL_PORT=COM3
TURNSTILE_BAUD_RATE=9600
TURNSTILE_RESPONSE_TIMEOUT_MS=2500
TURNSTILE_READY_TIMEOUT_MS=5000

# Autenticacion: reemplazar todos los placeholders fuera de desarrollo.
JWT_SECRET=reemplazar-por-un-secreto-largo-y-aleatorio
# El login actual emite sesiones de 1 dia; esta variable es el fallback del firmador.
JWT_EXPIRES_IN_DAYS=30
TOKEN_ACCESS_KEY=reemplazar-access-key
TOKEN_SECRET_KEY=reemplazar-secret-key

# Servicio facial y matching.
FACE_SERVICE_URL=http://127.0.0.1:8000
FACE_SERVICE_TIMEOUT_MS=30000
FACE_MATCH_THRESHOLD=0.5

# Archivos y OCR.
UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE_BYTES=5242880
VISITOR_DOC_MAX_BYTES=5242880

# Visitantes, usuarios, registros y alertas.
VISITOR_TICKET_TTL_MINUTES=10
VISITOR_TICKETS_PAGE_SIZE=10
VISITOR_TICKETS_MAX_SIZE=100
USERS_PAGE_SIZE=10
USERS_PAGE_MAX_SIZE=50
USERS_SUMMARY_RECENT_LIMIT=6
REGISTROS_PAGE_SIZE=10
REGISTROS_MAX_LIMIT=100
REGISTROS_MAX_RANGE_DAYS=90
ALERT_THRESHOLD_MINUTES=5
ALERTS_PAGE_SIZE=10
ALERTS_MAX_LIMIT=100

# Credenciales exclusivas para scripts locales de evaluacion.
EVALUATION_EMAIL=admin-evaluacion@example.com
EVALUATION_PASSWORD=reemplazar-password-evaluacion
EVALUATION_TOKEN=
EVALUATION_API_URL=http://127.0.0.1:3000/api
FACE_EVAL_DATASET_DIR=evaluation/dataset-prueba
FACE_EVAL_OUTPUT_ROOT=evaluation/face-runs
FACE_EVAL_THRESHOLD_START=0.30
FACE_EVAL_THRESHOLD_END=0.90
FACE_EVAL_THRESHOLD_STEP=0.05
EMBEDDING_MAP_LIMIT=60
ADMIN_SEED_NAME=Admin
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=reemplazar-password-admin
ADMIN_SEED_IMAGE=https://ui-avatars.com/api/?name=Admin&background=0f766e&color=ffffff
