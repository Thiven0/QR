{
  "info": {
    "name": "Plataforma QR - Backend API",
    "_postman_id": "0cc2d634-05f8-4f1c-b443-11a1e7e25567",
    "description": "Coleccion alineada con las rutas vigentes. Use primero Login y copie el token a authToken.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "authToken", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" },
    { "key": "registroId", "value": "", "type": "string" },
    { "key": "faceRecognitionLogId", "value": "", "type": "string" },
    { "key": "imageDataUrl", "value": "data:image/jpeg;base64,REEMPLAZAR", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{authToken}}", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "Autenticacion",
      "item": [
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"reemplazar\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Devuelve token, usuario y ticket cuando aplica. Guarde token en authToken."
          }
        },
        {
          "name": "Perfil",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/profile" }
        },
        {
          "name": "Logout",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/auth/logout" }
        },
        {
          "name": "Token tecnico",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"access_key\": \"reemplazar\",\n  \"secret_key\": \"reemplazar\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/auth/token"
          }
        }
      ]
    },
    {
      "name": "Usuarios",
      "item": [
        {
          "name": "Crear usuario",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Ana\",\n  \"apellido\": \"Perez\",\n  \"email\": \"ana@example.com\",\n  \"password\": \"reemplazar\",\n  \"cedula\": \"1234567890\",\n  \"imagen\": \"/uploads/profiles/reemplazar.jpg\",\n  \"facultad\": \"Ingenieria\",\n  \"rolAcademico\": \"Estudiante\",\n  \"permisoSistema\": \"Usuario\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/users"
          }
        },
        {
          "name": "Listar usuarios",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/users?page=1&limit=10&search=&estado=&permiso=&includeVisitorTicket=true" }
        },
        {
          "name": "Resumen usuarios",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/users/summary" }
        },
        {
          "name": "Detalle usuario",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/users/{{userId}}/detail" }
        },
        {
          "name": "Actualizar usuario",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Ana actualizada\",\n  \"apellido\": \"Perez\",\n  \"email\": \"ana@example.com\",\n  \"cedula\": \"1234567890\",\n  \"RH\": \"O+\",\n  \"telefono\": \"3000000000\",\n  \"imagen\": \"/uploads/profiles/reemplazar.jpg\",\n  \"imagenQR\": \"/uploads/qr/reemplazar.png\",\n  \"facultad\": \"Ingenieria\",\n  \"rolAcademico\": \"Estudiante\",\n  \"permisoSistema\": \"Usuario\",\n  \"estado\": \"activo\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/users/{{userId}}"
          }
        },
        {
          "name": "Eliminar usuario",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/users/{{userId}}" }
        },
        {
          "name": "Bloquear o desbloquear",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"cedula\": \"1234567890\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/users/toggle-access"
          }
        },
        {
          "name": "Parsear texto escaneado",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"rawText\": \"Ana Perez\\n1234567890\\nIngenieria\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/users/parse-scan"
          }
        },
        {
          "name": "Parsear QR",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"qrData\": \"Ana Perez\\n1234567890\\nIngenieria\\nO+\\n3000000000\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/users/parse-qr"
          }
        },
        {
          "name": "Validar escaneo",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"cedula\": \"1234567890\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/users/validate-scan"
          }
        }
      ]
    },
    {
      "name": "Registros",
      "item": [
        {
          "name": "Crear manual",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"cedula\": \"1234567890\",\n  \"fechaEntrada\": \"2026-07-25T13:00:00.000Z\",\n  \"horaEntrada\": \"08:00:00\",\n  \"observaciones\": \"Ingreso manual\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/exitEntry"
          }
        },
        {
          "name": "Listar registros",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/exitEntry?page=1&limit=10&status=todos&search=&from=&to=" }
        },
        {
          "name": "Detalle registro",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/exitEntry/{{registroId}}" }
        },
        {
          "name": "Actualizar registro",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"observaciones\": \"Actualizado\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/exitEntry/{{registroId}}"
          }
        },
        {
          "name": "Eliminar registro",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/exitEntry/{{registroId}}" }
        },
        {
          "name": "Movimiento desde QR",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"direction\": \"entry\",\n  \"scanMethod\": \"qr\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/exitEntry/from-scan"
          }
        },
        {
          "name": "Movimiento desde rostro",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"direction\": \"entry\",\n  \"scanMethod\": \"face\",\n  \"faceRecognitionLogId\": \"{{faceRecognitionLogId}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/exitEntry/from-scan"
          }
        },
        {
          "name": "Reset escaneo",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/exitEntry/reset-scan" }
        },
        {
          "name": "Alertas",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/exitEntry/alerts?page=1&limit=10&thresholdMinutes=5" }
        },
        {
          "name": "Resolver alerta",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"acknowledged\",\n  \"notes\": \"Validado por porteria; la sesion sigue abierta\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/exitEntry/{{registroId}}/alert"
          }
        },
        {
          "name": "Estadisticas",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/exitEntry/stats?start=2026-07-01&end=2026-07-31&faculty=" }
        }
      ]
    },
    {
      "name": "Visitantes",
      "item": [
        {
          "name": "Registrar visitante",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Visitante\",\n  \"apellido\": \"Ejemplo\",\n  \"email\": \"visitante@example.com\",\n  \"password\": \"reemplazar\",\n  \"cedula\": \"987654321\",\n  \"imagen\": \"/uploads/profiles/reemplazar.jpg\",\n  \"imagenQR\": \"/uploads/qr/reemplazar.png\",\n  \"documentImage\": \"/uploads/documents/reemplazar.jpg\",\n  \"faceImage\": \"{{imageDataUrl}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/visitors/register"
          }
        },
        {
          "name": "OCR documento",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"image\": \"{{imageDataUrl}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/visitors/ocr"
          }
        },
        {
          "name": "Expirar sesion",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/visitors/expire" }
        },
        {
          "name": "Reactivar ticket",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"userId\": \"{{userId}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/visitors/reactivate"
          }
        },
        {
          "name": "Listar tickets",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/visitors/tickets?page=1&limit=10" }
        }
      ]
    },
    {
      "name": "Reconocimiento facial",
      "item": [
        {
          "name": "Extraer embedding",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"image\": \"{{imageDataUrl}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/face/extract"
          }
        },
        {
          "name": "Enrolar rostro",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"image\": \"{{imageDataUrl}}\",\n  \"force\": false\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/face/enroll"
          }
        },
        {
          "name": "Identificar rostro",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"image\": \"{{imageDataUrl}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/face/identify"
          }
        },
        {
          "name": "Estadisticas faciales",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/face/stats?start=2026-07-01&end=2026-07-31&faculty=" }
        }
      ]
    },
    {
      "name": "Uploads",
      "item": [
        {
          "name": "Subir perfil",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": [] }] },
            "url": "{{baseUrl}}/api/upload/profile"
          }
        },
        {
          "name": "Subir QR",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": [] }] },
            "url": "{{baseUrl}}/api/upload/qr"
          }
        },
        {
          "name": "Subir documento",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": [] }] },
            "url": "{{baseUrl}}/api/upload/document"
          }
        }
      ]
    }
  ]
}
